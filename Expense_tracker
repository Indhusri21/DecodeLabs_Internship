def expense_tracker():
    expenses=[]

    print("===================================")
    print("         EXPENSE TRACKER           ")
    print("===================================")

    print("\nENTER EXPENSE AMOUNTS:"
    "\n[Enter 0 when you entered all expense amounts]")

    while True:
        expense_amount = input().strip()

        if expense_amount == "0":
            break

        try:
            expense_amount = float(expense_amount)
            expenses.append(expense_amount)
        except ValueError:
            print("Invalid entry.Enter valid number.")
    print("\n--------RECORDED EXPENSES-------")
    for index, amount in enumerate(expenses, start=1):
        print(f"Expense {index}: ₹{amount:.2f}")
        
    total_spent = sum(expenses)
    print("\n--------TOTAL EXPENSE---------")
    print(f"₹{total_spent:.2f}")
    print("--------------------------------")
expense_tracker()